generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dealer {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  dealershipName String
  contactPerson  String
  phoneNumber    String
  address        String?
  city           String?
  country        String?
  approvalStatus String    @default("pending") // pending, approved, rejected
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  listings       Listing[]
  alerts         Alert[]
}

model Listing {
  id          String         @id @default(cuid())
  dealerId    Int
  dealer      Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  
  // Vehicle Information
  make        String
  model       String
  year        Int
  mileage     Int
  variant     String?
  
  // Listing Details
  price       Float
  currency    String         @default("AED")
  description String         @db.Text
  features    String         @db.Text // JSON array stored as text
  condition   String         // NEW, USED, CERTIFIED
  
  // Location
  city        String
  region      String
  
  // Status
  status      String         @default("DRAFT") // DRAFT, ACTIVE, SOLD, EXPIRED
  
  // Images
  images      ListingImage[]
  
  // Metadata
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  publishedAt DateTime?
  
  @@index([dealerId])
  @@index([status])
  @@index([make, model])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String   // URL/Path to the image in public folder
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  
  @@index([listingId])
}


// Alert preferences for dealers
model Alert {
  id        Int      @id @default(autoincrement())
  dealerId  Int
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  
  make      String
  model     String
  yearMin   Int?
  yearMax   Int?
  variant   String?
  region    String
  
  frequency String   @default("daily") // daily, weekly, monthly
  enabled   Boolean  @default(true)   // false = cron temporarily skips this alert
  lastRun   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerId])
}

// Car Taxonomy Models
model CarMake {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  models    CarModel[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CarModel {
  id        Int          @id @default(autoincrement())
  name      String
  makeId    Int
  make      CarMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants  CarVariant[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([makeId, name])
  @@index([makeId])
}

model CarVariant {
  id        Int      @id @default(autoincrement())
  name      String
  modelId   Int
  model     CarModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modelId, name])
  @@index([modelId])
}
