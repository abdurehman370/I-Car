generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  password        String
  role            String    @default("admin")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdAuctions Auction[]
  alerts          Alert[]
}

model Dealer {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  password             String
  dealershipName       String?
  contactPerson        String
  phoneNumber          String
  address              String?
  city                 String?
  country              String?
  role                 String                @default("User")
  approvalStatus       String                @default("pending") // pending, approved, rejected
  licenseDocumentUrl   String? // dealership license uploaded at signup
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  listings             Listing[]
  alerts               Alert[]
  auctionBids          AuctionBid[]
  auctionNotifications AuctionNotification[]
  pushSubscriptions    PushSubscription[]
  wonAuctions          Auction[]             @relation("AuctionWinner")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  dealerId  Int
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerId])
}

model Listing {
  id       String @id @default(cuid())
  dealerId Int
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  // Vehicle Information
  make    String
  model   String
  year    Int
  mileage Int
  variant String?

  // Listing Details
  price       Float
  currency    String @default("AED")
  description String @db.Text
  features    String @db.Text // JSON array stored as text
  condition   String // NEW, USED, CERTIFIED

  // Location
  city   String
  region String

  // Status
  status String @default("DRAFT") // DRAFT, ACTIVE, SOLD, EXPIRED

  // Images
  images ListingImage[]

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  auctions    Auction[]

  @@index([dealerId])
  @@index([status])
  @@index([make, model])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String // URL/Path to the image in public folder
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

// Market alerts — owned by an admin (userId). dealerId kept nullable for legacy dealer alerts.
model Alert {
  id       Int     @id @default(autoincrement())
  dealerId Int?
  dealer   Dealer? @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId   Int? // admin (User) who created this alert from the admin panel
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  make     String
  model    String
  yearMin  Int?
  yearMax  Int?
  variant  String?
  region   String

  frequency String    @default("daily") // daily, weekly, monthly
  enabled   Boolean   @default(true) // false = cron temporarily skips this alert
  lastRun   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([dealerId])
  @@index([userId])
}

// Car Taxonomy Models
model CarMake {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  models    CarModel[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CarModel {
  id        Int          @id @default(autoincrement())
  name      String
  makeId    Int
  make      CarMake      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants  CarVariant[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([makeId, name])
  @@index([makeId])
}

model CarVariant {
  id        Int      @id @default(autoincrement())
  name      String
  modelId   Int
  model     CarModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([modelId, name])
  @@index([modelId])
}

// =====================
// AUCTION MODULE
// =====================

model Auction {
  id Int @id @default(autoincrement())

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  createdByAdminId Int?
  createdByAdmin   User? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  title       String
  make        String
  model       String
  year        Int
  mileage     Int
  variant     String?
  region      String
  city        String?
  description String  @db.Text

  // Hybrid auction support
  auctionType  String  @default("ONLINE") // ONLINE, PHYSICAL, HYBRID
  venue        String? // physical venue name/address (PHYSICAL / HYBRID)
  displayToken String? @unique // secret token for the public big-screen display page

  startingBid  Decimal  @db.Decimal(12, 2)
  reservePrice Decimal? @db.Decimal(12, 2)
  minIncrement Decimal  @db.Decimal(12, 2)
  currency     String   @default("AED")

  status   String    @default("DRAFT")
  startAt  DateTime
  endAt    DateTime
  closedAt DateTime?

  currentHighestBid Decimal? @db.Decimal(12, 2)
  winnerDealerId    Int?
  winnerDealer      Dealer?  @relation("AuctionWinner", fields: [winnerDealerId], references: [id], onDelete: SetNull)

  outcome String?

  images        AuctionImage[]
  bids          AuctionBid[]
  notifications AuctionNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startAt])
  @@index([endAt])
  @@index([listingId])
  @@index([winnerDealerId])
}

model AuctionImage {
  id        Int     @id @default(autoincrement())
  auctionId Int
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  url       String
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([auctionId])
}

model AuctionBid {
  id Int @id @default(autoincrement())

  auctionId Int
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  dealerId Int?
  dealer   Dealer? @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  userId   Int?
  userType String? // dealer, user. Use only if public users exist.

  bidderName  String?
  bidderEmail String?

  source       String  @default("online") // online (dealer portal), floor (entered by admin at physical venue)
  paddleNumber String? // paddle number for floor bids

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("AED")
  status   String  @default("active") // active, outbid, winning, rejected

  createdAt DateTime @default(now())

  @@index([auctionId])
  @@index([dealerId])
  @@index([userId])
  @@index([amount])
  @@index([createdAt])
}

model AuctionNotification {
  id Int @id @default(autoincrement())

  auctionId Int
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  dealerId Int?
  dealer   Dealer? @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  userId   Int?
  userType String?

  recipientEmail String?
  recipientName  String?

  type      String
  title     String
  message   String  @db.Text
  isRead    Boolean @default(false)
  sentEmail Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([auctionId])
  @@index([dealerId])
  @@index([userId])
  @@index([isRead])
}
